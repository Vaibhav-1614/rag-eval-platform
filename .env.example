# Copy to .env (git-ignored).

# Required for SEC downloads (ingestion only): identify yourself (name + email)
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: Gemini key for the Streamlit dashboard / testset generation
# (the API service also accepts it if GEMINI_API_KEY is unset)
GOOGLE_API_KEY=

# ---- Production API service (all optional) ----
# Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# Gemini (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
# Langfuse tracing (free Hobby plan): https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Limits
RATE_LIMIT=10/minute
DAILY_LLM_CAP=500
# Require an X-API-Key header on /v1/* (comma-separated keys). Empty = open API.
API_KEYS=
# Reverse proxies in front of the app that append X-Forwarded-For (1 on Hugging Face
# Spaces / Cloud Run, 0 when the app is reached directly). Used for per-IP rate limits.
TRUSTED_PROXY_HOPS=0
# Postgres for feedback + the daily LLM counter (free: https://neon.tech or
# https://supabase.com). Empty = SQLite file, which free hosts wipe on restart.
DATABASE_URL=
